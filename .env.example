# Copy this file to .env.local and fill in the values. Next.js loads only
# .env.local in development; no .env* file is ever committed except this one.
# Production values live in the Vercel dashboard, not in a file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
AI_MODEL_DAILY=
AI_MODEL_CHAT=
AI_MODEL_REPORT=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REMINDER_TEMPLATE=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=

# Optional, tooling only (never read by the app):
# SUPABASE_DB_URL is the Session pooler URI used to push migrations to the
# hosted project. Keep it in .env.hosted, which Next.js does not load.
# SUPABASE_DB_URL=
